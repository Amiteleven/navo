/// Execution phase of a deal after final approval. Drives the category-specific
/// fulfillment workflow that follows deal creation.
enum DealExecutionStatus {
  /// Deal approved but no fulfillment activity recorded yet.
  PENDING_EXECUTION
  /// Supplier has acknowledged the deal / confirmed the order.
  SUPPLIER_CONFIRMED
  /// Procurement activity is underway (PO raised, work commenced, etc.).
  IN_PROGRESS
  /// Goods received or service milestone(s) completed.
  FULFILLED
  /// All fulfillment criteria are complete.
  CLOSED
  /// Execution was cancelled by the buyer before completion.
  CANCELLED
}

/// How the underlying requirement is fulfilled, derived from the offer type.
enum DealExecutionType {
  /// Physical goods → PO + goods receipt.
  PRODUCTS
  /// Services / consulting → SOW + milestones + deliverables.
  SERVICES
  /// SaaS / subscription licensing → subscription tracking.
  SAAS_SUBSCRIPTION
  /// Project-based deliverables → milestones + deliverables.
  PROJECT
}

/// Event types for the deal execution audit trail.
enum DealExecutionEventType {
  /// The deal was created from the approved final offer.
  DEAL_CREATED
  /// Supplier acknowledged / confirmed the order.
  SUPPLIER_CONFIRMED
  /// A purchase order was raised against the deal.
  PURCHASE_ORDER_RAISED
  /// Goods were received and accepted.
  GOODS_RECEIVED
  /// A service milestone was completed.
  MILESTONE_COMPLETED
  /// A project deliverable was accepted.
  DELIVERABLE_ACCEPTED
  /// A subscription was registered for tracking.
  SUBSCRIPTION_REGISTERED
  /// The execution phase advanced to a new status.
  EXECUTION_STATUS_ADVANCED
  /// The execution was cancelled.
  EXECUTION_CANCELLED
}

/// Audit trail of execution-phase events for a deal.
model DealExecutionEvent {
  id                String                   @id @default(cuid())
  dealId            String
  tenantId          String
  type              DealExecutionEventType
  /// Human-readable summary of what happened.
  description       String
  /// The user who recorded the event.
  actorId           String?
  /// Arbitrary context (e.g. PO number, milestone index, receipt reference).
  metadata          Json?
  createdAt         DateTime                 @default(now())

  actor             User?                     @relation("ExecutionActor", fields: [actorId], references: [id])
  deal              Deal                      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@index([type])
  @@index([createdAt])
}

