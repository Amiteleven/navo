/// One organization's manager-approval configuration.
///
/// This is the single source of truth for "who must approve what, and when".
/// Monetary thresholds live here and only here - never as constants in code -
/// so an organization sets its own numbers and the rule that gated each
/// historical purchase can be replayed from the row.
///
/// `version` increments on every change. A submitted request records the version
/// and the resolved rule it used, so later policy edits cannot retroactively
/// change what a past approval meant.
model PurchaseApprovalPolicy {
  id                                String                    @id @default(cuid())
  tenantId                          String                    @unique
  name                              String                    @default("Purchase approval policy")
  description                       String?
  /// The currency every threshold on this policy is expressed in. Amounts are
  /// compared in Decimal and only against rules carrying the same currency;
  /// NAVO performs no implicit FX conversion, so a rule in another currency is
  /// rejected at configuration time rather than silently mis-comparing.
  currency                          String                    @default("INR")
  isActive                          Boolean                   @default(true)
  version                           Int                       @default(1)
  /// Whether taxes count toward the amount compared against thresholds.
  /// Excluding them lets an organization authorize by net spend rather than by
  /// cash out of the door; the choice is recorded on the policy and echoed into
  /// each request's snapshot.
  includeTaxesInThreshold           Boolean                   @default(true)
  /// Whether freight, installation and other charges count toward thresholds.
  includeDeliveryChargesInThreshold Boolean                   @default(true)
  /// Purchases whose threshold amount is strictly below this proceed without a
  /// manager decision. Null disables the exemption entirely (every purchase
  /// needs approval). This is the "small purchase" allowance; the amount is the
  /// organization's to choose and is expressed in `currency`.
  autoApproveBelowAmount            Decimal?                  @db.Decimal(18, 4)
  /// Off by default: a buyer must not approve their own spend. An organization
  /// may permit it, but only by setting this flag *and* recording a written
  /// justification, which is retained on the policy and copied into the audit
  /// trail of every decision taken under it.
  allowSelfApproval                 Boolean                   @default(false)
  selfApprovalJustification         String?
  /// Which commercial changes force reapproval of an already-approved purchase,
  /// e.g. { "priceIncrease": true, "priceDecrease": false, "quantity": true }.
  reapprovalRules                   Json?
  /// Guards against splitting one purchase into several sub-threshold requests.
  /// Compared on submitter + vendor + item within the window.
  splitGuardEnabled                 Boolean                   @default(true)
  splitGuardWindowDays              Int                       @default(30)
  updatedById                       String?
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime                  @updatedAt
  tenant                            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests                          PurchaseApprovalRequest[]
  rules                             PurchaseApprovalRule[]

  @@index([tenantId])
}

/// A scoped condition plus the approval hierarchy it requires.
///
/// Evaluation is "most specific active rule wins", where specificity counts the
/// scope attributes a rule actually names (department, category, cost centre,
/// and a bounded amount range). Ties break on the lower `priority`, so an
/// administrator can force an ordering. A rule naming no scope attributes is the
/// organization-wide fallback and therefore the least specific.
model PurchaseApprovalRule {
  id              String                    @id @default(cuid())
  tenantId        String
  policyId        String
  name            String
  /// Lower runs first when two rules are equally specific.
  priority        Int                       @default(100)
  isActive        Boolean                   @default(true)
  /// Inclusive lower bound, exclusive upper bound, both in the policy currency.
  /// Null on either side means unbounded on that side.
  minAmount       Decimal?                  @db.Decimal(18, 4)
  maxAmount       Decimal?                  @db.Decimal(18, 4)
  /// Scope. A null attribute matches any value; a non-null attribute must equal
  /// the purchase's value.
  department      String?
  categoryId      String?
  costCenter      String?
  /// When false, purchases matching this rule need no manager decision at all.
  requireApproval Boolean                   @default(true)
  /// Ordered approval hierarchy, e.g.
  /// [{ "level": 1, "requiredRole": "PROCUREMENT_MANAGER", "label": "Procurement review" },
  /// { "level": 2, "requiredRole": "FINANCE_APPROVER", "label": "Finance review" }]
  /// Evaluated strictly in ascending order. `approverIds` names specific
  /// approvers for the level; when empty, any active user holding
  /// `requiredRole` may decide.
  levels          Json
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  requests        PurchaseApprovalRequest[]
  category        Category?                 @relation(fields: [categoryId], references: [id])
  policy          PurchaseApprovalPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, priority])
  @@index([policyId])
  @@index([categoryId])
}

/// One purchase authorization request: a buyer asking a manager to release
/// company funds for a specific negotiated offer.
///
/// The commercial block is an immutable snapshot of the offer as submitted. It is
/// never edited in place - a changed offer becomes a new revision - which is
/// what makes the recorded total the total that was actually approved.
model PurchaseApprovalRequest {
  id                    String                     @id @default(cuid())
  /// Human-facing document reference, unique per tenant.
  reference             String
  tenantId              String
  /// The requirement, vendor, negotiation room and final offer this authorizes.
  requestId             String
  vendorId              String
   dealRoomId             String?
   /// At most one authorization per deal. Enforced here rather than in a service
   /// so a concurrent second submission cannot both pass the check.
   dealId                 String?                    @unique
   offerId               String?
   quoteId               String?
   /// The selected winning submission from the 4-offer commercial engine.
   /// Present when the approval was submitted from a CommercialOfferSubmission;
   /// null when it came from the negotiation DealOffer path.
   selectedSubmissionId   String?
   submittedById          String
  status                PurchaseApprovalStatus     @default(PENDING_APPROVAL)
  currency              String                     @default("INR")
  unitPrice             Decimal                    @db.Decimal(18, 4)
  quantity              Int
  taxRate               Decimal                    @default(0) @db.Decimal(9, 4)
  taxAmount             Decimal                    @default(0) @db.Decimal(18, 4)
  freightAmount         Decimal                    @default(0) @db.Decimal(18, 4)
  installationAmount    Decimal                    @default(0) @db.Decimal(18, 4)
  otherCharges          Decimal                    @default(0) @db.Decimal(18, 4)
  subtotal              Decimal                    @db.Decimal(18, 4)
  /// Everything the buyer will pay: subtotal + tax + freight + installation + other.
  totalAmount           Decimal                    @db.Decimal(18, 4)
  /// The amount actually compared against thresholds, after applying the
  /// policy's tax/charge inclusion flags. Stored so a reviewer can see exactly
  /// which figure the rule was evaluated against.
  thresholdAmount       Decimal                    @db.Decimal(18, 4)
  paymentTerms          String?
  deliveryTimelineDays  Int?
  warrantyMonths        Int?
  /// Free-text delivery schedule agreed with the seller.
  deliverySchedule      String?
  otherChargesDetails   String?
  /// Seller-supplied supporting documents, copied from the offer at submission.
  documents             Json?
  /// Null only when the organization has no active policy, in which case the
  /// request is auto-approved and records why.
  policyId              String?
  policyVersion         Int?
  appliedRuleId         String?
  /// Verbatim copy of the policy flags and the resolved rule's levels, so the
  /// decision can be explained years later without replaying configuration.
  policySnapshot        Json?
  ruleSnapshot          Json?
  requesterComment      String?
  /// Summary of the negotiation that produced this offer: every offer in the
  /// room, in order, plus message and offer counts. Stored rather than joined so
  /// an approver sees the history that existed when they decided.
  negotiationSnapshot   Json?
  /// The level currently awaiting a decision. Advanced as levels are approved.
  currentLevel          Int                        @default(1)
  revision              Int                        @default(1)
  /// Chain of revisions. A revised offer supersedes its predecessor rather than
  /// overwriting it, so the previously approved figures and the decision given
  /// against them both survive.
  parentRequestId       String?
  supersededById        String?
  supersedeReason       String?
  supersededAt          DateTime?
  decidedAt             DateTime?
  purchaseConfirmedAt   DateTime?
  purchaseConfirmedById String?
  /// The purchase order this authorization released. One-to-one, so a second
  /// order cannot be raised against the same authorization.
  purchaseOrderId       String?                    @unique
  cancelledAt           DateTime?
  cancelReason          String?
  dueAt                 DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  decisions             PurchaseApprovalDecision[]
  appliedRule           PurchaseApprovalRule?      @relation(fields: [appliedRuleId], references: [id])
  deal                  Deal?                      @relation(fields: [dealId], references: [id])
  dealRoom              DealRoom?                  @relation(fields: [dealRoomId], references: [id])
   offer                 DealOffer?                 @relation(fields: [offerId], references: [id])
   policy                PurchaseApprovalPolicy?    @relation(fields: [policyId], references: [id])
   purchaseConfirmedBy   User?                      @relation("ApprovalConfirmedBy", fields: [purchaseConfirmedById], references: [id])
   purchaseOrder         PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id])
   request               ProcurementRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
   selectedSubmission    CommercialOfferSubmission? @relation(fields: [selectedSubmissionId], references: [id])
   submittedBy           User                       @relation("ApprovalSubmittedBy", fields: [submittedById], references: [id])
   tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
   vendor                Vendor                     @relation(fields: [vendorId], references: [id])

   @@unique([reference, tenantId])
   @@unique([offerId, tenantId])
   @@index([tenantId, status])
   @@index([requestId, status])
   @@index([submittedById, status])
   @@index([vendorId])
   @@index([offerId])
   @@index([selectedSubmissionId])
   @@index([dealId])
}

/// One approval level of a purchase authorization request.
///
/// Levels are created up front from the applied rule, so the hierarchy a request
/// was routed through is visible before anyone has acted on it, and a level can
/// never be quietly added after the fact.
model PurchaseApprovalDecision {
  id                        String                         @id @default(cuid())
  tenantId                  String
  purchaseApprovalRequestId String
  level                     Int
  requiredRole              UserRole
  label                     String?
  status                    PurchaseApprovalDecisionStatus @default(PENDING)
  /// The specific approver this level is routed to, resolved at submission from
  /// the rule's `approverIds` or from a user holding `requiredRole`. Null means
  /// the level is open to any active holder of `requiredRole`.
  assignedApproverId        String?
  /// Set when the level was reassigned or delegated, so a decision can be traced
  /// to the person who was actually asked.
  delegatedFromApproverId   String?
  delegationReason          String?
  decidedById               String?
  /// Mandatory for REJECTED and CHANGES_REQUESTED; enforced in the service.
  comments                  String?
  decidedAt                 DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  assignments               PurchaseApprovalAssignment[]
  assignedApprover          User?                          @relation("ApprovalAssignedApprover", fields: [assignedApproverId], references: [id])
  decidedBy                 User?                          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  purchaseApprovalRequest   PurchaseApprovalRequest        @relation(fields: [purchaseApprovalRequestId], references: [id], onDelete: Cascade)
  tenant                    Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([purchaseApprovalRequestId, level])
  @@index([tenantId, status])
  @@index([assignedApproverId, status])
}

/// Permanent record of every reassignment or delegation of an approval level.
///
/// Separate from `PurchaseApprovalDecision` because the decision row is updated
/// in place, whereas who was asked must survive every subsequent change.
model PurchaseApprovalAssignment {
  id             String                   @id @default(cuid())
  tenantId       String
  decisionId     String
  fromApproverId String?
  toApproverId   String
  reason         String
  createdById    String
  createdAt      DateTime                 @default(now())
  createdBy      User                     @relation("ApprovalAssignmentActor", fields: [createdById], references: [id])
  decision       PurchaseApprovalDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toApprover     User                     @relation("ApprovalAssignmentTo", fields: [toApproverId], references: [id])

  @@index([tenantId])
  @@index([decisionId])
  @@index([toApproverId])
}

model AuditLog {
  id               String      @id @default(cuid())
  userId           String
  action           AuditAction
  entityType       String
  entityId         String
  previousStatus   String?
  newStatus        String?
  decision         String?
  aiRecommendation String?
  metadata         Json?
  tenantId         String
  createdAt        DateTime    @default(now())
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Connection {
  id          String             @id @default(cuid())
  requestId   String
  buyerId     String
  vendorId    String
  status      ConnectionStatus   @default(PENDING)
  initiatedAt DateTime           @default(now())
  respondedAt DateTime?
  tenantId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  buyer       User               @relation("ConnectionBuyer", fields: [buyerId], references: [id])
  request     ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenant      Tenant             @relation("connections", fields: [tenantId], references: [id], onDelete: Cascade)
  vendor      Vendor             @relation("Connections", fields: [vendorId], references: [id], onDelete: Cascade)
  dealRoom    DealRoom?

  @@unique([requestId, vendorId])
  @@index([tenantId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([status])
}

model DealRoom {
  id                       String                    @id @default(cuid())
  connectionId             String                    @unique
  requestId                String
  buyerId                  String
  vendorId                 String
  status                   DealRoomStatus            @default(ACTIVE)
  closedAt                 DateTime?
  dealId                   String?
  tenantId                 String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deal                     Deal?
  messages                 DealMessage[]
  offers                   DealOffer[]
  buyer                    User                      @relation("DealRoomBuyer", fields: [buyerId], references: [id])
  connection               Connection                @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  request                  ProcurementRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenant                   Tenant                    @relation("dealRooms", fields: [tenantId], references: [id], onDelete: Cascade)
  vendor                   Vendor                    @relation("dealRooms", fields: [vendorId], references: [id], onDelete: Cascade)
  negotiationMessages      NegotiationMessage[]
  purchaseApprovalRequests PurchaseApprovalRequest[]

  @@index([tenantId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([status])
}

model DealMessage {
  id           String              @id @default(cuid())
  dealRoomId   String
  senderId     String
  senderRole   String
  content      String
  messageType  String              @default("TEXT")
  createdAt    DateTime            @default(now())
  dealRoom     DealRoom            @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  readReceipts DealMessageRead[]
  attachments  MessageAttachment[]

  @@index([dealRoomId])
  @@index([createdAt])
}

/// Per-recipient read state within a deal room. One row per (reader, message).
model DealMessageRead {
  id         String      @id @default(cuid())
  messageId  String
  readerId   String
  dealRoomId String
  readAt     DateTime    @default(now())
  message    DealMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reader     User        @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@unique([messageId, readerId])
  @@index([readerId, dealRoomId])
}

/// A file shared inside a negotiation room.
///
/// Access requires deal-room participation, checked on every read, so an
/// attachment can never be fetched by id alone.
model MessageAttachment {
  id           String      @id @default(cuid())
  messageId    String
  dealRoomId   String
  fileName     String
  mimeType     String
  size         Int
  content      Bytes
  uploadedById String
  createdAt    DateTime    @default(now())
  message      DealMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   Vendor      @relation("MessageAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([dealRoomId])
}

model DealOffer {
  id                       String                    @id @default(cuid())
  dealRoomId               String
  submittedById            String
  submittedByRole          String
  unitPrice                Float
  quantity                 Int
  gst                      Float                     @default(0)
  freightAmount            Float                     @default(0)
  installationAmount       Float                     @default(0)
  warrantyMonths           Int?
  deliveryTimelineDays     Int?
  paymentTerms             String?
  validityDays             Int?
  otherCharges             Float                     @default(0)
  otherChargesDetails      String?
  status                   DealOfferStatus           @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  acceptedDeal             Deal?                     @relation("AcceptedDeal")
  dealRoom                 DealRoom                  @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  purchaseApprovalRequests PurchaseApprovalRequest[]

  @@index([dealRoomId])
  @@index([status])
}

model Deal {
  id                      String                   @id @default(cuid())
  dealNumber              String                   @unique
  dealRoomId              String?                  @unique
  requestId               String
  buyerId                 String
  vendorId                String
  status                  DealStatus               @default(ACCEPTED)
  acceptedOfferId         String?                  @unique
  tenantId                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  /// Execution phase of the deal lifecycle: procurement → fulfillment → closure.
  executionStatus         DealExecutionStatus      @default(PENDING_EXECUTION)
  /// How the underlying requirement is fulfilled. Derived from the request's offerType.
  executionType           DealExecutionType?
  /// The selected commercial submission that this deal is based on.
  selectedSubmissionId    String?                  @unique
  /// Immutable snapshot of the winning submission's commercial terms, copied at deal creation.
  commercialSnapshot      Json?
  /// When the supplier confirmed acceptance of the deal.
  supplierConfirmedAt     DateTime?
  supplierConfirmedById   String?
  acceptedOffer           DealOffer?               @relation("AcceptedDeal", fields: [acceptedOfferId], references: [id])
  buyer                   User                     @relation("DealBuyer", fields: [buyerId], references: [id])
  dealRoom                DealRoom?                 @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  request                 ProcurementRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenant                  Tenant                   @relation("deals", fields: [tenantId], references: [id], onDelete: Cascade)
  vendor                  Vendor                   @relation("deals", fields: [vendorId], references: [id], onDelete: Cascade)
  purchaseApprovalRequest PurchaseApprovalRequest?
  purchaseOrder           PurchaseOrder?
  selectedSubmission      CommercialOfferSubmission? @relation(fields: [selectedSubmissionId], references: [id])
  executionEvents         DealExecutionEvent[]

  @@index([tenantId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([status])
  @@index([dealNumber])
  @@index([executionStatus])
}

model VendorAvailability {
