///
/// This is the FIRST approval in the NAVO workflow: the Department Head approves
/// the business need BEFORE vendor sourcing begins. This is distinct from the
/// PurchaseApproval which happens AFTER vendor offers are received and a deal is
/// negotiated (the SECOND approval - final commercial approval).
enum RequirementApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SEND_BACK
  CANCELLED
  SUPERSEDED
}

enum RequirementApprovalDecisionStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}
