  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model VendorRating {
  id         String    @id @default(cuid())
  vendorId   String
  buyerId    String
  rating     Int
  feedback   String?
  categories Json?
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  verifiedBy String?
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  buyer      User      @relation("VendorRatingBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, buyerId])
  @@index([tenantId])
  @@index([vendorId])
   @@index([buyerId])
}

/// Capability profile for a vendor. `matchingFactors` is a JSON bag of
/// factor→weight pairs (weight = 0..1). The matching engine reads this to
/// score vendors against procurement requirements.
model VendorCapability {
  id               String            @id @default(cuid())
  vendorId         String
  tenantId         String
  /// Capability name
  name             String?
  /// Capability category or tag, e.g. "cloud-migration", "sap-consulting".
  category         String?
  /// Free-text description of the capability.
  description      String?
  /// Proficiency level, e.g. "Beginner", "Intermediate", "Expert"
  proficiencyLevel String?
  /// factor→weight pairs, e.g. { "CATEGORY_EXPERIENCE": 0.3, ... }
  matchingFactors  Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor           Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vendorId])
  @@index([category])
}

/// A certification held by a vendor (e.g. ISO-9001, GSTIN, etc.).
/// The `status` tracks verification lifecycle; `validUntil` triggers
/// automatic expiry warnings via `VendorOnboarding` status checks.
model VendorCertification {
  id               String                   @id @default(cuid())
  vendorId         String
  tenantId         String
  /// e.g. "ISO 9001:2015", "GSTIN"
  name             String
  issuingBody      String?
  status           VendorCertificationStatus @default(SELF_DECLARED)
  /// Issued on / expires on
  validFrom        DateTime?
  validUntil       DateTime?
  /// Link to the uploaded supporting document
  documentId       String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  document         VendorDocument?          @relation("CertificationDocument", fields: [documentId], references: [id])
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor           Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vendorId])
  @@index([name])
}

/// A document uploaded by or for a vendor during onboarding or certification.
model VendorDocument {
  id                   String              @id @default(cuid())
  vendorId             String
  tenantId             String
  type                 VendorDocumentType
  /// Original file name
  fileName             String
  /// MIME type, e.g. application/pdf
  mimeType             String?
  sizeBytes            Int
  /// Storage path or URL
  path                 String
  /// User who uploaded the document
  uploadedById        String?
  /// Optional verification status
  status               VendorCertificationStatus @default(SELF_DECLARED)
  verifiedAt           DateTime?
  verifiedById         String?
  /// Back-reference: certifications that use this document
  certifications       VendorCertification[] @relation("CertificationDocument")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy           User?               @relation("VendorDocumentUploader", fields: [uploadedById], references: [id])
  verifiedBy           User?               @relation("VendorDocumentVerifier", fields: [verifiedById], references: [id])
  vendor               Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vendorId])
  @@index([type])
}

/// Onboarding state machine for a vendor within a tenant.
/// State machine: NOT_STARTED → IN_PROGRESS → PENDING_REVIEW → APPROVED
///                                              ↓         REJECTED / ON_HOLD
model VendorOnboarding {
  id                   String                    @id @default(cuid())
  vendorId             String                    @unique
  tenantId             String
  status               VendorOnboardingStatus    @default(INVITED)
  /// The user who submitted the onboarding for review
  submittedById        String?
  /// The user who approved/rejected
  reviewedById         String?
  startedAt            DateTime?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  /// Comments / notes from reviewers
  reviewComments       String?
  /// Documents still missing (server-computed list of required doc types)
  missingDocuments     Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  reviewedBy           User?                     @relation("VendorOnboardingReviewer", fields: [reviewedById], references: [id])
  submittedBy          User?                     @relation("VendorOnboardingSubmitter", fields: [submittedById], references: [id])
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor               Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

/// A matching run: how a vendor scored against a procurement request.
/// `factorScores` is a JSON bag of factor→score pairs (score 0..100).
model VendorMatching {
  id                 String    @id @default(cuid())
  requestId          String
  vendorId           String
  tenantId           String
  /// Overall match score 0..100
  score              Float
  /// factor→score pairs
  factorScores       Json
  /// factor→weight pairs used for this run
  matchingFactors    Json
  /// Reason snippets for the score
  rationale          String?
  matchedById        String?
  createdAt          DateTime  @default(now())
  matchedBy          User?     @relation(fields: [matchedById], references: [id])

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor             Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  request            ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([requestId])
  @@index([vendorId])
  @@index([score])
}

/// Private routing between a matched vendor and a procurement request.
/// A vendor can only access requests they are assigned to.
model VendorAssignment {
  id                 String    @id @default(cuid())
  requestId          String
  vendorId           String
  tenantId           String
  assignedById       String?
  assignedAt         DateTime  @default(now())
  /// When the vendor accepted the assignment
  acceptedAt         DateTime?
  /// When the vendor declined
  declinedAt         DateTime?
  /// Reason if declined
  declineReason      String?
  /// Whether the vendor has submitted a quotation
  hasQuoted          Boolean   @default(false)
  /// Optional notes about the assignment
  notes              String?
  /// Number of commercial submissions made by this vendor for this assignment.
  /// Enforced to a maximum of FOUR in the initial round.
  offersSubmitted    Int       @default(0)
  /// True once the vendor has used all four submissions.
  finalOfferSubmitted Boolean  @default(false)
  /// The current commercial round. Round 1 is the initial four-offer round;
  /// each buyer-reopened round increments this.
  commercialRound    Int       @default(1)
  /// When the vendor response deadline was extended, if any.
  deadlineExtendedAt DateTime?
  /// Reason for the deadline extension.
  deadlineExtensionReason String?
  /// ISO currency code for this assignment's commercial round.
  currency           String?   @default("INR")
  assignedBy         User?     @relation("VendorAssignments", fields: [assignedById], references: [id])

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor             Vendor             @relation("VendorAssignments", fields: [vendorId], references: [id], onDelete: Cascade)
  request            ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  commercialOffers   CommercialOffer[]

  @@unique([requestId, vendorId])
  @@index([tenantId])
  @@index([vendorId])
  @@index([assignedById])
}

/// Commercial history for a vendor — recorded spend, quote counts, etc.
/// Money fields use Decimal for precision; never store as Float.
model VendorCommercialHistory {
  id                 String    @id @default(cuid())
  vendorId           String
  tenantId           String
  /// Period start (month)
  periodStart        DateTime
  /// Total spend in this period
  totalSpend         Decimal   @db.Decimal(12,2)
  /// Number of purchase orders in this period
  orderCount         Int       @default(0)
  /// Average discount percentage
  avgDiscountPct     Float?
  /// Currency code, e.g. "INR"
  currency           String    @default("INR")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

   @@index([tenantId])
   @@index([vendorId])
   @@index([periodStart])
}

/// A vendor's structured commercial offer in response to an assigned requirement.
///
/// The `CommercialOffer` is the parent lifecycle entity. Each revision the vendor
/// submits is stored as an immutable `CommercialOfferSubmission` — the submitted
/// amounts are never overwritten. Offer numbering is sequential per vendor
/// assignment and resets on a buyer-reopened commercial round.
model CommercialOffer {
  id                    String                       @id @default(cuid())
  tenantId              String
  requestId             String
  vendorAssignmentId    String
  vendorId              String
  /// The latest submission number (1–4) within the current round.
  currentSubmissionNumber Int @default(0)
  /// The current overall lifecycle status (draft → submitted → final, etc.).
  status                OfferStatus                  @default(VENDOR_INVITED)
  /// What kind of offer this is, so the editor adapts its fields.
  offerType             OfferType                    @default(PRODUCT)
  /// Number of submissions made in the current commercial round.
  submissionsInRound    Int                          @default(0)
  /// True once the vendor has used all four submissions in the initial round.
  finalOfferSubmitted   Boolean                      @default(false)
  /// The current commercial round. Round 1 is the initial four-offer round.
  commercialRound       Int                          @default(1)
  /// ISO 4217 currency code. Must match the assignment currency.
  currency              String                       @default("INR")
  /// When the vendor response deadline expires for this offer.
  deadline              DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

   tenant                Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
   request               ProcurementRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
   vendorAssignment      VendorAssignment             @relation(fields: [vendorAssignmentId], references: [id], onDelete: Cascade)
   vendor                Vendor                       @relation("OfferVendor", fields: [vendorId], references: [id], onDelete: Cascade)
   submissions           CommercialOfferSubmission[]
   events                OfferEvent[]

  @@unique([vendorAssignmentId, commercialRound])
  @@index([tenantId])
  @@index([requestId])
  @@index([vendorId])
  @@index([status])
}

/// An immutable snapshot of a single commercial submission.
///
/// Once created, the monetary and terms fields on a submission are never
/// updated. A revised offer creates a new submission that links back to the
/// previous one via `previousSubmissionId`, forming an auditable chain.
model CommercialOfferSubmission {
  id                    String                       @id @default(cuid())
  commercialOfferId     String
  tenantId              String
  /// 1, 2, 3, or 4 within the current round, reset by a reopened round.
  submissionNumber      Int
  /// Links to the previous submission in the chain, for audit history.
  previousSubmissionId  String?
  /// What kind of offer — determines which structured fields are populated.
  offerType             OfferType
  /// ISO 4217 currency code. The original currency is always preserved.
  currency              String
  /// --- Core monetary fields (Decimal for exact arithmetic) ---
  /// Tax-exclusive subtotal (unitPrice × quantity, or recurring subtotal).
  subTotal              Decimal                     @db.Decimal(18, 4)
  /// Tax amount.
  taxAmount             Decimal                     @default(0) @db.Decimal(18, 4)
  /// Everything the buyer will pay.
  totalAmount           Decimal                     @db.Decimal(18, 4)
  /// Discount applied, as a flat amount.
  discountAmount        Decimal?                    @db.Decimal(18, 4)
  /// Discount applied, as a percentage (0–100).
  discountPercentage    Float?
  /// --- Product-specific fields ---
  unitPrice             Decimal?                    @db.Decimal(18, 4)
  quantity              Int?
  /// --- Service / project fields ---
  contractDuration      String?
  milestones            Json?
  deliverables          Json?
  serviceLevels         Json?
  staffingAssumptions   String?
  /// --- SaaS subscription fields ---
  numberOfLicenses      Int?
  billingFrequency      String?
  subscriptionTerm      String?
  renewalTerms          String?
  implementationFees    Decimal?                    @db.Decimal(18, 4)
  recurringFees         Decimal?                    @db.Decimal(18, 4)
  oneTimeFees           Decimal?                    @db.Decimal(18, 4)
  /// --- Common commercial terms ---
  /// Delivery date for products, or service commencement date.
  deliveryDate          DateTime?
  paymentTerms          String?
  /// How long the offer is valid for.
  offerValidityDays     Int?
  offerValidityDate     DateTime?
  /// Free-text commercial conditions (INCOTERMS, etc.).
  commercialConditions  String?
  /// Free-text scope description.
  scope                 String?
  /// Free-text exclusions.
  exclusions            String?
  /// Document IDs attached to this submission.
  supportingDocuments   String[]                    @default([])
  /// --- Compliance ---
  complianceStatus      OfferComplianceStatus       @default(REQUIRES_REVIEW)
  /// Machine-generated compliance notes.
  complianceDetails     Json?
  /// --- Submission metadata ---
  submittedAt           DateTime?
  submittedById         String?
  /// True for the fourth submission in the initial round.
  isFinal               Boolean                     @default(false)
  /// Idempotency key for safe retries.
  idempotencyKey        String?                     @unique
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

   tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
   commercialOffer       CommercialOffer             @relation(fields: [commercialOfferId], references: [id], onDelete: Cascade)
    submittedBy           User?                       @relation("OfferSubmitter", fields: [submittedById], references: [id])
    previousSubmission    CommercialOfferSubmission?  @relation("OfferSubmissionChain", fields: [previousSubmissionId], references: [id])
    nextSubmissions        CommercialOfferSubmission[] @relation("OfferSubmissionChain")
    offerEvents           OfferEvent[]
    purchaseApprovalRequests PurchaseApprovalRequest[]
    deals                Deal[]

    @@unique([commercialOfferId, submissionNumber])
   @@index([tenantId])
  @@index([commercialOfferId])
  @@index([submissionNumber])
  @@index([previousSubmissionId])
  @@index([submittedById])
}

/// Audit trail for commercial offer actions.
enum OfferEventType {
  OFFER_DRAFT_CREATED
  OFFER_DRAFT_UPDATED
  OFFER_SUBMITTED
  OFFER_REVISED
  OFFER_REVIEWED
  OFFER_WITHDRAWN
  OFFER_DECLINED
  OFFER_EXPIRED
  REJECTED_AS_NONCOMPLIANT
  COMPLIANCE_EVALUATED
  COMMERCIAL_PROCESS_REOPENED
  CLARIFICATION_REQUESTED
  CLARIFICATION_ANSWERED
  DEADLINE_EXTENDED
}

model OfferEvent {
  id                  String              @id @default(cuid())
  tenantId            String
  commercialOfferId   String
  submissionId        String?
  /// e.g. OFFER_DRAFT_CREATED, OFFER_SUBMITTED, OFFER_REVISED, etc.
  eventType           OfferEventType
  /// Human-readable description of the event.
  description         String
  /// The user or system that triggered the event.
  actorId             String?
  /// Arbitrary context about the event.
  metadata          Json?
  createdAt           DateTime            @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commercialOffer     CommercialOffer     @relation(fields: [commercialOfferId], references: [id], onDelete: Cascade)
  submission          CommercialOfferSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  actor               User?               @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([commercialOfferId])
  @@index([eventType])
  @@index([createdAt])
}

/// Types of commercial offers.
enum OfferType {
  /// Physical goods / products.
  PRODUCT
  /// Professional services or consulting engagements.
  SERVICE
  /// Software subscriptions and SaaS licensing.
  SOFTWARE_SUBSCRIPTION
}

/// Lifecycle status of a commercial offer.
///
/// This tracks the overall state of the offer container, not individual submissions.
enum OfferStatus {
  /// The vendor has been invited but hasn't started an offer.
  VENDOR_INVITED
  /// The vendor has accepted the invitation and can prepare an offer.
  VENDOR_ACCEPTED
  /// The vendor is working on a draft submission.
  OFFER_DRAFT
  /// The vendor submitted a commercial offer.
  OFFER_SUBMITTED
  /// The buyer is reviewing the submitted offer.
  OFFER_UNDER_REVIEW
  /// The vendor submitted a revised offer (within the 4-offer limit).
  OFFER_REVISED
  /// The fourth and final offer has been submitted.
  FINAL_OFFER_SUBMITTED
  /// The vendor declined the opportunity.
  DECLINED
  /// The vendor withdrew their offer.
  WITHDRAWN
  /// The offer deadline passed before submission.
  EXPIRED
  /// The offer was rejected as non-compliant with mandatory requirements.
  REJECTED_AS_NONCOMPLIANT
  /// The buyer reopened the commercial process after the fourth offer.
  COMMERCIAL_PROCESS_REOPENED
}

/// Compliance evaluation result for a commercial submission.
enum OfferComplianceStatus {
  /// All mandatory fields are present and values satisfy deterministic rules.
  COMPLIANT
  /// Some mandatory fields are missing or partially satisfied.
  PARTIALLY_COMPLIANT
  /// A mandatory commercial term is violated.
  NON_COMPLIANT
  /// Not yet evaluated — requires manual review.
  REQUIRES_REVIEW
}

/// Potential duplicate detection between two vendors.
/// `primaryVendorId` is the canonical record; `secondaryVendorId` is the
/// suspected duplicate. Confidence indicates match quality.
model VendorDuplicate {
  id                 String                    @id @default(cuid())
  primaryVendorId    String
  secondaryVendorId  String
  tenantId           String
  confidence         VendorDuplicateConfidence
  /// Which fields matched, e.g. ["email", "phone"]
  matchedFields      Json
  /// Confidence score 0..100
  score              Float
  /// When the duplicate was detected
  detectedAt         DateTime                @default(now())
  /// Whether a human confirmed the match
  confirmed          Boolean                 @default(false)
  confirmedById      String?
  confirmedAt        DateTime?
  /// The canonical (surviving) vendor
  primaryVendor      Vendor                  @relation("VendorDuplicatesPrimary", fields: [primaryVendorId], references: [id], onDelete: Cascade)
  /// The suspected duplicate vendor
  secondaryVendor    Vendor                  @relation("VendorDuplicatesSecondary", fields: [secondaryVendorId], references: [id], onDelete: Cascade)
  confirmedBy        User?                   @relation(fields: [confirmedById], references: [id])

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([primaryVendorId, secondaryVendorId])
  @@index([tenantId])
  @@index([confidence])
  @@index([confirmed])
}

/// Audit trail for vendor lifecycle events (onboarding, matching, assignment, etc.)
model VendorEvent {
  id                 String    @id @default(cuid())
  vendorId           String
  tenantId           String
  /// e.g. "ONBOARDING_STATUS_CHANGED", "MATCHED", "ASSIGNED"
  eventType          String
  /// Human-readable description
  description        String
  /// Actor who triggered the event
  actorId            String?
  /// Arbitrary metadata (JSON) — context about the event
  metadata           Json?
  createdAt          DateTime  @default(now())
  actor              User?     @relation("VendorEventActor", fields: [actorId], references: [id])

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vendorId])
  @@index([eventType])
  @@index([createdAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  title     String
  message   String
  data      Json?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  tenantId  String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  /// Unique per logical in-app notification. A repeated trigger - a retried
  /// request, two approvals fired together - loses the insert race instead of
  /// showing the user the same alert twice. Null for notifications written
  /// before deduplication, which Postgres permits to repeat.
  dedupeKey String?              @unique
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User                 @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model QuoteAnalysis {
  id          String            @id @default(cuid())
  quoteId     String
  type        QuoteAnalysisType
  content     Json
  confidence  Float             @default(0)
  evidence    Json?
  generatedBy String?
  tenantId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  quote       Quote             @relation("quoteAnalyses", fields: [quoteId], references: [id], onDelete: Cascade)
  tenant      Tenant            @relation("quoteAnalyses", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@index([type])
}

model NegotiationMessage {
  id          String            @id @default(cuid())
  dealRoomId  String
  senderId    String
  senderRole  String
  content     String
  messageType String            @default("TEXT")
  metadata    Json?
  targetPrice Float?
  status      NegotiationStatus @default(ACTIVE)
  tenantId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  dealRoom    DealRoom          @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  tenant      Tenant            @relation("negotiationMessages", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealRoomId])
  @@index([createdAt])
}

model PriceBenchmark {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  item        String?
  location    String?
  quantity    Int?
  unit        String?
  minPrice    Float
  avgPrice    Float
  maxPrice    Float
  sampleSize  Int
  dataSource  String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation("priceBenchmarks", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([categoryId])
  @@index([item])
  @@index([periodStart, periodEnd])
}

model SavingsRecord {
  id                  String             @id @default(cuid())
  dealId              String?            @unique
  requestId           String
  buyerId             String
  vendorId            String
  type                SavingsType
  originalQuoteAmount Float
  finalAcceptedAmount Float
  baselineAmount      Float?
  baselineSource      String?
  baselinePeriodStart DateTime?
  baselinePeriodEnd   DateTime?
  savingsAmount       Float
  savingsPercentage   Float
  calculationMethod   String
  evidence            Json?
  verifiedAt          DateTime?
  verifiedBy          String?
  tenantId            String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  buyer               User               @relation("SavingsRecordBuyer", fields: [buyerId], references: [id])
  request             ProcurementRequest @relation("savingsRecords", fields: [requestId], references: [id], onDelete: Cascade)
  tenant              Tenant             @relation("savingsRecords", fields: [tenantId], references: [id], onDelete: Cascade)
  vendor              Vendor             @relation("savingsRecords", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([type])
  @@index([requestId])
}

/// A purchase order created from an accepted Deal. Commercial terms are copied
/// from the accepted offer at creation time and never silently overwritten:
/// later amendments are recorded through audit entries and status changes.
model PurchaseOrder {
  id                            String                   @id @default(cuid())
  poNumber                      String                   @unique
  dealId                        String                   @unique
  requestId                     String
  buyerId                       String
  vendorId                      String
  status                        PurchaseOrderStatus      @default(DRAFT)
  currency                      String                   @default("INR")
  itemName                      String
  description                   String?
  quantity                      Int
  unit                          String?
  unitPrice                     Decimal                  @db.Decimal(18, 4)
  taxRate                       Decimal                  @default(0) @db.Decimal(9, 4)
  taxAmount                     Decimal                  @default(0) @db.Decimal(18, 4)
  freightAmount                 Decimal                  @default(0) @db.Decimal(18, 4)
  installationAmount            Decimal                  @default(0) @db.Decimal(18, 4)
  otherCharges                  Decimal                  @default(0) @db.Decimal(18, 4)
  otherChargesDetails           String?
  subtotal                      Decimal                  @db.Decimal(18, 4)
  totalAmount                   Decimal                  @db.Decimal(18, 4)
  acceptedOfferId               String
  acceptedOfferSnapshot         Json?
  deliveryAddress               String?
  expectedDeliveryDate          DateTime?
  actualDeliveryDate            DateTime?
  paymentTerms                  String?
  warrantyMonths                Int?
  notes                         String?
  terms                         String?
  issuedAt                      DateTime?
  supplierConfirmedAt           DateTime?
  closedAt                      DateTime?
  cancelledAt                   DateTime?
  rejectionReason               String?
  supplierConfirmedDeliveryDate DateTime?
  dispatchTrackingRef           String?
  dispatchNotes                 String?
  tenantId                      String
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  approvalRequestId             String?                  @unique
  deliveryEvents                DeliveryEvent[]
  documents                     Document[]
  goodsReceipts                 GoodsReceipt[]
  invoices                      Invoice[]
  verifications                 InvoiceVerification[]
  payments                      Payment[]
  approvalRequest               PurchaseApprovalRequest?
  buyer                         User                     @relation("PurchaseOrderBuyer", fields: [buyerId], references: [id])
  deal                          Deal                     @relation(fields: [dealId], references: [id])
  request                       ProcurementRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenant                        Tenant                   @relation("purchaseOrders", fields: [tenantId], references: [id], onDelete: Cascade)
  vendor                        Vendor                   @relation("PurchaseOrderVendor", fields: [vendorId], references: [id])
  approvals                     PurchaseOrderApproval[]

  @@index([tenantId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([status])
  @@index([poNumber])
  @@index([requestId])
  @@index([approvalRequestId])
}

/// Multi-level approval record for a purchase order. Levels are created up-front
/// from the tenant approval policy so issuing is gated on all required approvals.
model PurchaseOrderApproval {
  id           String         @id @default(cuid())
  poId         String
  level        Int
  requiredRole UserRole
  approverId   String?
  status       ApprovalStatus @default(PENDING)
  comments     String?
  decidedAt    DateTime?
  decidedById  String?
  tenantId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  approver     User?          @relation("POApprover", fields: [approverId], references: [id])
  decidedBy    User?          @relation("POApprovedBy", fields: [decidedById], references: [id])
  po           PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation("purchaseOrderApprovals", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([poId, level])
  @@index([tenantId])
  @@index([status])
}

/// Chronological delivery milestone recorded by the supplier (or buyer noting an
/// exception). This is a manual/explicit status trail - NAVO does not poll any
/// carrier system.
model DeliveryEvent {
  id                    String            @id @default(cuid())
  poId                  String
  type                  DeliveryEventType
  notes                 String?
  location              String?
  carrierName           String?
  trackingRef           String?
  estimatedDeliveryDate DateTime?
  occurredAt            DateTime          @default(now())
  actorId               String
  documentIds           String[]
  tenantId              String
  createdAt             DateTime          @default(now())
  actor                 User              @relation("DeliveryEventActor", fields: [actorId], references: [id])
  po                    PurchaseOrder     @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant                Tenant            @relation("deliveryEvents", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([tenantId])
  @@index([type])
}

/// A goods receipt records what physically arrived. Multiple receipts against one
/// PO are supported for partial deliveries; order status is derived from the
/// sum of accepted quantities so a PO is never marked delivered on a part receipt.
model GoodsReceipt {
  id               String        @id @default(cuid())
  receiptNumber    String        @unique
  poId             String
  orderedQuantity  Int
  receivedQuantity Int
  acceptedQuantity Int
  rejectedQuantity Int
  receiptDate      DateTime      @default(now())
  receivedById     String
  conditionNotes   String?
  discrepancies    Json?
  documentIds      String[]
  tenantId         String
  createdAt        DateTime      @default(now())
  po               PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  receivedBy       User          @relation("GoodsReceiptRecorder", fields: [receivedById], references: [id])
  tenant           Tenant        @relation("goodsReceipts", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([tenantId])
}

/// A supplier invoice raised against a confirmed purchase order. `extractedData`
/// holds AI/OCR-extracted values and is kept separate from the verified
/// three-way match result so extracted data is never presented as verified.
model Invoice {
  id                  String                @id @default(cuid())
  invoiceNumber       String
  poId                String
  vendorId            String
  status              InvoiceStatus         @default(SUBMITTED)
  currency            String                @default("INR")
  invoiceDate         DateTime
  dueDate             DateTime?
  subtotal            Decimal               @db.Decimal(18, 4)
  taxRate             Decimal?              @db.Decimal(9, 4)
  taxAmount           Decimal               @default(0) @db.Decimal(18, 4)
  freightAmount       Decimal               @default(0) @db.Decimal(18, 4)
  otherCharges        Decimal               @default(0) @db.Decimal(18, 4)
  otherChargesDetails String?
  totalAmount         Decimal               @db.Decimal(18, 4)
  description         String?
  extractedData       Json?
  extractionMethod    String?
  extractedAt         DateTime?
  documentIds         String[]
  tenantId            String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  submittedById       String?
  documents           Document[]
  po                  PurchaseOrder         @relation(fields: [poId], references: [id], onDelete: Cascade)
  submittedBy         User?                 @relation("InvoiceSubmitter", fields: [submittedById], references: [id])
  tenant              Tenant                @relation("invoices", fields: [tenantId], references: [id], onDelete: Cascade)
  vendor              Vendor                @relation("InvoiceVendor", fields: [vendorId], references: [id])
  verifications       InvoiceVerification[]
  payments            Payment[]

  @@unique([vendorId, invoiceNumber])
  @@index([poId])
  @@index([tenantId])
  @@index([status])
}

/// Result of the deterministic three-way match (PO ↔ Goods Receipt ↔ Invoice).
/// Every discrepancy records the field, expected vs actual values and the delta
/// so a reviewer can see exactly what caused it.
model InvoiceVerification {
  id              String             @id @default(cuid())
  invoiceId       String
  poId            String
  status          InvoiceMatchStatus @default(NOT_STARTED)
  matched         Boolean            @default(false)
  discrepancies   Json?
  checkedFields   Json?
  toleranceAmount Decimal            @default(0) @db.Decimal(18, 4)
  verifiedById    String?
  verifiedAt      DateTime?
  notes           String?
  tenantId        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  invoice         Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  po              PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant          Tenant             @relation("invoiceVerifications", fields: [tenantId], references: [id], onDelete: Cascade)
  verifiedBy      User?              @relation("InvoiceVerifier", fields: [verifiedById], references: [id])

  @@index([invoiceId])
  @@index([poId])
  @@index([tenantId])
  @@index([status])
}

/// Payment progress is recorded for reporting only. NAVO does not initiate bank
/// or payment-gateway transfers; a user records an externally made payment.
model Payment {
  id            String        @id @default(cuid())
  poId          String
  invoiceId     String?
  status        PaymentStatus @default(NOT_DUE)
  amount        Decimal       @default(0) @db.Decimal(18, 4)
  currency      String        @default("INR")
  paidAmount    Decimal       @default(0) @db.Decimal(18, 4)
  reference     String?
  paymentMethod String?
  paidAt        DateTime?
  dueDate       DateTime?
  notes         String?
  recordedById  String
  tenantId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  recordedBy    User          @relation("PaymentRecorder", fields: [recordedById], references: [id])
  tenant        Tenant        @relation("payments", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([tenantId])
  @@index([status])
}

/// Uploaded supporting file. Bytes are stored in the database so access is always
/// tenant-scoped and authorized - there is no public/static file path.
model Document {
  id           String           @id @default(cuid())
  poId         String?
  invoiceId    String?
  category     DocumentCategory
  fileName     String
  mimeType     String
  size         Int
  content      Bytes
  uploadedById String
  tenantId     String
  createdAt    DateTime         @default(now())
  invoice      Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  po           PurchaseOrder?   @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation("documents", fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([poId])
  @@index([invoiceId])
  @@index([tenantId])
}

/// A requirement draft created through the conversational AI intake flow.
/// Unlike ProcurementRequest, this represents the pre-formalization state where
/// the buyer is still clarifying what they need. It becomes a ProcurementRequest
/// when the buyer confirms and the requirement is commercially actionable.
model RequirementDraft {
  id                     String                    @id @default(cuid())
  tenantId               String
  userId                 String
  copilotConversationId  String?                   @unique
  /// Current state in the intake flow
  state                  RequirementDraftState     @default(NEW)
  /// Core extracted fields (always present when known)
  title                  String?
  category               String?
  item                   String?
  description            String?
  specifications         Json?
  quantity               Int?
  unit                   String?
  budget                 Decimal?                  @db.Decimal(18, 4)
  currency               String?                   @default("INR")
  location               String?
  requiredBy             DateTime?
  serviceDuration        String?
  contractDuration       String?
  qualityRequirements    String?
  brandPreference        String?
  model                  String?
  complianceRequirements String?
  certifications         String?
  paymentExpectations    String?
  deliveryExpectations   String?
  otherRequirements      Json?
  /// What the AI still needs to ask about
  missingFields          String[]                  @default([])
  /// When the draft was confirmed and ready for sourcing
  confirmedAt            DateTime?
  confirmedById          String?
  /// Link to the created ProcurementRequest
  requestId              String?                   @unique
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  version                Int                       @default(1)
  clarifications         ClarificationQuestion[]   @relation("ClarificationQuestions")
  confirmedBy            User?                     @relation("RequirementDraftConfirmedBy", fields: [confirmedById], references: [id])
  request                ProcurementRequest?       @relation("RequirementDraftRequest", fields: [requestId], references: [id])
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User                      @relation("RequirementDraftUser", fields: [userId], references: [id])
  versions               RequirementDraftVersion[] @relation("DraftVersions")

  @@index([tenantId])
  @@index([userId])
  @@index([state])
  @@index([copilotConversationId])
}

/// Version history for requirement drafts
model RequirementDraftVersion {
  id            String           @id @default(cuid())
  draftId       String
  versionNumber Int
  changeSummary String
  changedFields String[]         @default([])
  snapshot      Json
  changedById   String?
  createdAt     DateTime         @default(now())
  draft         RequirementDraft @relation("DraftVersions", fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, versionNumber])
  @@index([draftId, createdAt])
}

/// A clarification question asked by the AI during intake
model ClarificationQuestion {
  id           String           @id @default(cuid())
  draftId      String
  field        String
  question     String
  aiSuggestion String?
  userAnswer   String?
  answeredAt   DateTime?
  order        Int
  draft        RequirementDraft @relation("ClarificationQuestions", fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, field])
  @@index([draftId])
  @@index([field])
}

/// One organization's department-approval configuration for requirements.
model RequirementApprovalPolicy {
  id                        String                       @id @default(cuid())
  tenantId                  String                       @unique
  name                      String                       @default("Requirement approval policy")
  description               String?
  currency                  String                       @default("INR")
  isActive                  Boolean                      @default(true)
  version                   Int                          @default(1)
  /// Purchases whose estimated value is strictly below this proceed without a
  /// department approval. Null disables the exemption entirely.
  autoApproveBelowAmount    Decimal?                     @db.Decimal(18, 4)
  /// Whether a requester can approve their own requirement (off by default).
  allowSelfApproval         Boolean                      @default(false)
  selfApprovalJustification String?
  /// Which changes force reapproval of an already-approved requirement.
  reapprovalRules           Json?
  updatedById               String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  tenant                    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests                  RequirementApprovalRequest[]
  rules                     RequirementApprovalRule[]

  @@index([tenantId])
}

/// A scoped condition plus the approval hierarchy it requires for requirements.
model RequirementApprovalRule {
  id              String                       @id @default(cuid())
  tenantId        String
  policyId        String
  name            String
  priority        Int                          @default(100)
  isActive        Boolean                      @default(true)
  /// Inclusive lower bound, exclusive upper bound, both in the policy currency.
  minAmount       Decimal?                     @db.Decimal(18, 4)
  maxAmount       Decimal?                     @db.Decimal(18, 4)
  /// Scope attributes. Null matches any value.
  department      String?
  categoryId      String?
  costCenter      String?
  /// When false, requirements matching this rule need no approval at all.
  requireApproval Boolean                      @default(true)
  /// Ordered approval hierarchy, e.g.
  /// [{ "level": 1, "requiredRole": "COMPANY_ADMIN", "label": "Department Head review" }]
  levels          Json
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  requests        RequirementApprovalRequest[]
  category        Category?                    @relation(fields: [categoryId], references: [id])
  policy          RequirementApprovalPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, priority])
  @@index([policyId])
  @@index([categoryId])
}

/// One department approval request: a buyer asking their Department Head to
/// approve the business need before vendor sourcing begins.
model RequirementApprovalRequest {
  id                  String                        @id @default(cuid())
  reference           String
  tenantId            String
  /// The requirement this approval is for
  requestId           String
  submittedById       String
  status              RequirementApprovalStatus     @default(PENDING_APPROVAL)
  /// Estimated commercial snapshot (Decimal; never edited after creation)
  currency            String                        @default("INR")
  estimatedAmount     Decimal                       @db.Decimal(18, 4)
  /// The amount actually compared against thresholds.
  thresholdAmount     Decimal                       @db.Decimal(18, 4)
  /// Policy provenance
  policyId            String?
  policyVersion       Int?
  appliedRuleId       String?
  policySnapshot      Json?
  ruleSnapshot        Json?
  requesterComment    String?
  /// Summary of the requirement at submission time.
  requirementSnapshot Json?
  /// The level currently awaiting a decision.
  currentLevel        Int                           @default(1)
  revision            Int                           @default(1)
  /// Chain of revisions. A revised requirement supersedes its predecessor.
  parentRequestId     String?
  supersededById      String?
  supersedeReason     String?
  supersededAt        DateTime?
  decidedAt           DateTime?
  approvedAt          DateTime?
  approvedById        String?
  cancelledAt         DateTime?
  cancelReason        String?
  dueAt               DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  decisions           RequirementApprovalDecision[]
  appliedRule         RequirementApprovalRule?      @relation(fields: [appliedRuleId], references: [id])
  approvedBy          User?                         @relation("RequirementApprovalApprovedBy", fields: [approvedById], references: [id])
  policy              RequirementApprovalPolicy?    @relation(fields: [policyId], references: [id])
  request             ProcurementRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  submittedBy         User                          @relation("RequirementApprovalSubmittedBy", fields: [submittedById], references: [id])
  tenant              Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([reference, tenantId])
  @@unique([requestId, revision, tenantId])
  @@index([tenantId, status])
  @@index([requestId, status])
  @@index([submittedById, status])
}

/// One approval level of a requirement approval request.
model RequirementApprovalDecision {
  id                           String                            @id @default(cuid())
  tenantId                     String
  requirementApprovalRequestId String
  level                        Int
  requiredRole                 UserRole
  label                        String?
  status                       RequirementApprovalDecisionStatus @default(PENDING)
  /// The specific approver this level is routed to.
  assignedApproverId           String?
  /// Set when the level was reassigned or delegated.
  delegatedFromApproverId      String?
  delegationReason             String?
  decidedById                  String?
  /// Mandatory for REJECTED and CHANGES_REQUESTED; enforced in the service.
  comments                     String?
  decidedAt                    DateTime?
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  assignments                  RequirementApprovalAssignment[]
  assignedApprover             User?                             @relation("RequirementApprovalAssignedApprover", fields: [assignedApproverId], references: [id])
  decidedBy                    User?                             @relation("RequirementApprovalDecidedBy", fields: [decidedById], references: [id])
  requirementApprovalRequest   RequirementApprovalRequest        @relation(fields: [requirementApprovalRequestId], references: [id], onDelete: Cascade)
  tenant                       Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([requirementApprovalRequestId, level])
  @@index([tenantId, status])
  @@index([assignedApproverId, status])
}

/// Permanent record of every reassignment or delegation of a requirement approval level.
model RequirementApprovalAssignment {
  id             String                      @id @default(cuid())
  tenantId       String
  decisionId     String
  fromApproverId String?
  toApproverId   String
  reason         String
  createdById    String
  createdAt      DateTime                    @default(now())
  createdBy      User                        @relation("RequirementApprovalAssignmentActor", fields: [createdById], references: [id])
  decision       RequirementApprovalDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toApprover     User                        @relation("RequirementApprovalAssignmentTo", fields: [toApproverId], references: [id])

  @@index([tenantId])
  @@index([decisionId])
  @@index([toApproverId])
}

