/// Lifecycle of one purchase authorization request.
///
/// Kept distinct from `ApprovalStatus`, which is a single approver's verdict on
/// a requirement. These values describe the *purchase*, and the separation is
/// what stops an approved request from being shown as a completed purchase.
enum PurchaseApprovalStatus {
  /// Submitted and routed; at least one level is still open.
  PENDING_APPROVAL
  /// A manager returned it to the buyer with mandatory comments.
  CHANGES_REQUESTED
  /// Refused. Terminal until a revised offer is submitted.
  REJECTED
  /// Every required level approved. Not yet a purchase.
  APPROVED
  /// The buyer confirmed the purchase against the approved terms.
  PURCHASE_CONFIRMED
  /// Withdrawn by the buyer or an administrator.
  CANCELLED
  /// Replaced by a later revision, or invalidated by a material change.
  SUPERSEDED
}

/// Verdict on one approval level. `SKIPPED` records a level that the applied
/// rule withdrew (for example when a revision fell below a threshold), so the
/// history explains why it is absent rather than showing a hole.
enum PurchaseApprovalDecisionStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

/// Commercial change that can force an existing approval back through the
/// hierarchy. Which of these actually force reapproval is organization
