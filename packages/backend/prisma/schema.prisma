model VendorProfile {
  id                String   @id @default(cuid())
  vendorId          String   @unique
  companyName       String?
  registrationNo    String?
  gstin             String?
  panNumber         String?
  msmeNumber        String?
  website           String?
  description       String?
  certifications    String?
  capabilities      Json?
  deliveryLocations Json?
  paymentTerms      String?
  bankDetails       Json?
  documents         Json?
  tenantId          String
