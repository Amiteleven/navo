generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CopilotConversation {
  id           String              @id @default(cuid())
  title        String?
  userId       String
  tenantId     String
  contextType  CopilotContextType?
  contextId    String?
  contextLabel String?
  isArchived   Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  actions      CopilotAction[]
  tenant       Tenant              @relation("copilotConversations", fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation("CopilotConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages     CopilotMessage[]
  preferences  CopilotPreference[]

  @@index([userId, updatedAt])
  @@index([tenantId])
  @@index([isArchived])
}

model CopilotMessage {
  id                   String              @id @default(cuid())
  conversationId       String
  /// USER or ASSISTANT. Stored as a string so the model does not have to mirror
  /// an enum that the application never filters on.
  role                 String
  content              String
  /// Tools the assistant called to answer, with their arguments and outcomes.
  /// Json because it is audit metadata, never queried relationally.
  toolCalls            Json?
  /// Records referenced in the answer, so the UI can render NAVO links.
  citations            Json?
  /// True when the user has not yet confirmed a proposed action.
  requiresConfirmation Boolean             @default(false)
  createdAt            DateTime            @default(now())
  conversation         CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CopilotAction {
  id               String              @id @default(cuid())
  conversationId   String
  userId           String
  tenantId         String
  type             CopilotActionType
  status           CopilotActionStatus @default(PROPOSED)
  /// Human-readable summary of exactly what will happen.
  summary          String
  /// Validated tool arguments, replayed at execution time.
  payload          Json
  /// Record produced by a successful execution, for linking back into NAVO.
  resultEntityType String?
  resultEntityId   String?
  resultSummary    String?
  error            String?
  createdAt        DateTime            @default(now())
  confirmedAt      DateTime?
  executedAt       DateTime?
  conversation     CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant           Tenant              @relation("copilotActions", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([userId])
  @@index([tenantId])
}

model CopilotPreference {
  id             String               @id @default(cuid())
  conversationId String?
  userId         String
  tenantId       String
  key            String
  value          Json
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  conversation   CopilotConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant               @relation("copilotPreferences", fields: [tenantId], references: [id], onDelete: Cascade)
  user           User                 @relation("CopilotPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@index([tenantId])
}

model Tenant {
  id                             String                          @id @default(cuid())
  name                           String
  slug                           String                          @unique
  domain                         String?                         @unique
  logo                           String?
  settings                       Json?
  isActive                       Boolean                         @default(true)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  abuseReports                   AbuseReport[]
  approvals                      Approval[]
  auditLogs                      AuditLog[]
  categories                     Category[]
  connections                    Connection[]                    @relation("connections")
  contactRestrictions            ContactRestriction[]
  copilotActions                 CopilotAction[]                 @relation("copilotActions")
  copilotConversations           CopilotConversation[]           @relation("copilotConversations")
  copilotPreferences             CopilotPreference[]             @relation("copilotPreferences")
  deals                          Deal[]                          @relation("deals")
  dealRooms                      DealRoom[]                      @relation("dealRooms")
  deliveryEvents                 DeliveryEvent[]                 @relation("deliveryEvents")
  documents                      Document[]                      @relation("documents")
  emailDeliveries                EmailDelivery[]
  goodsReceipts                  GoodsReceipt[]                  @relation("goodsReceipts")
  invoices                       Invoice[]                       @relation("invoices")
  invoiceVerifications           InvoiceVerification[]           @relation("invoiceVerifications")
  marketplaceInterests           MarketplaceInterest[]
  negotiationMessages            NegotiationMessage[]            @relation("negotiationMessages")
  notifications                  Notification[]
  notificationPrefs              NotificationPreference[]
  payments                       Payment[]                       @relation("payments")
  policies                       Policy[]
  priceBenchmarks                PriceBenchmark[]                @relation("priceBenchmarks")
  requests                       ProcurementRequest[]
  approvalAssignments            PurchaseApprovalAssignment[]
  approvalDecisions              PurchaseApprovalDecision[]
  purchaseApprovalPolicy         PurchaseApprovalPolicy?
  purchaseApprovalRequests       PurchaseApprovalRequest[]
  purchaseOrders                 PurchaseOrder[]                 @relation("purchaseOrders")
  purchaseOrderApprovals         PurchaseOrderApproval[]         @relation("purchaseOrderApprovals")
  quotes                         Quote[]
  quoteAnalyses                  QuoteAnalysis[]                 @relation("quoteAnalyses")
  rfqs                           RFQ[]
  requestAttachments             RequestAttachment[]
  requirementApprovalAssignments RequirementApprovalAssignment[]
  requirementApprovalDecisions   RequirementApprovalDecision[]
  requirementApprovalPolicy      RequirementApprovalPolicy?
  requirementApprovalRequests    RequirementApprovalRequest[]
  requirementDrafts              RequirementDraft[]
  savingsRecords                 SavingsRecord[]                 @relation("savingsRecords")
  users                          User[]
  vendors                        Vendor[]
  vendorAvailabilities           VendorAvailability[]            @relation("vendorAvailabilities")
  vendorInvitations              VendorInvitation[]
  vendorProfiles                 VendorProfile[]
  vendorRatings                  VendorRating[]
  vendorWorkingHours             VendorWorkingHours[]
  vendorCapabilities             VendorCapability[]
  vendorCertifications           VendorCertification[]
  vendorDocuments                VendorDocument[]
  vendorOnboardings              VendorOnboarding[]
  vendorMatchings                VendorMatching[]
   vendorAssignments              VendorAssignment[]
   vendorCommercialHistories       VendorCommercialHistory[]
   vendorDuplicates                VendorDuplicate[]
   vendorEvents                    VendorEvent[]
   commercialOffers                 CommercialOffer[]
   commercialOfferSubmissions      CommercialOfferSubmission[]
    offerEvents                    OfferEvent[]
    dealExecutionEvents            DealExecutionEvent[]

    @@index([slug])
   @@index([domain])
}

model User {
  id                                     String                          @id @default(cuid())
  email                                  String
  passwordHash                           String
  firstName                              String
  lastName                               String
  avatar                                 String?
  role                                   UserRole                        @default(REQUESTER)
  isActive                               Boolean                         @default(true)
  lastLoginAt                            DateTime?
  tenantId                               String
  createdAt                              DateTime                        @default(now())
  updatedAt                              DateTime                        @updatedAt
  vendorId                               String?
  costCenter                             String?
  department                             String?
  abuseReportsFiled                      AbuseReport[]                   @relation("ReportReporter")
  approvals                              Approval[]                      @relation("Approver")
  auditLogs                              AuditLog[]
  connectionsAsBuyer                     Connection[]                    @relation("ConnectionBuyer")
  restrictionsAsBuyer                    ContactRestriction[]            @relation("RestrictionBuyer")
  copilotConversations                   CopilotConversation[]           @relation("CopilotConversations")
  copilotPreferences                     CopilotPreference[]             @relation("CopilotPreferences")
   dealsAsBuyer                           Deal[]                          @relation("DealBuyer")
   dealExecutionEventsAsActor             DealExecutionEvent[]          @relation("ExecutionActor")
   dealMessagesRead                       DealMessageRead[]
  dealRoomsAsBuyer                       DealRoom[]                      @relation("DealRoomBuyer")
  deliveryEvents                         DeliveryEvent[]                 @relation("DeliveryEventActor")
  uploadedDocuments                      Document[]                      @relation("DocumentUploader")
  emailDeliveries                        EmailDelivery[]                 @relation("EmailDeliveryRecipient")
  goodsReceipts                          GoodsReceipt[]                  @relation("GoodsReceiptRecorder")
  invoicesSubmitted                      Invoice[]                       @relation("InvoiceSubmitter")
  invoicesVerified                       InvoiceVerification[]           @relation("InvoiceVerifier")
  marketplaceInterests                   MarketplaceInterest[]           @relation("InterestSubmitter")
  notifications                          Notification[]                  @relation("UserNotifications")
  notificationPrefs                      NotificationPreference[]        @relation("NotificationPreferenceUser")
  paymentsRecorded                       Payment[]                       @relation("PaymentRecorder")
  assignedRequests                       ProcurementRequest[]            @relation("Assignee")
  requests                               ProcurementRequest[]            @relation("Requester")
  approvalAssignmentsMade                PurchaseApprovalAssignment[]    @relation("ApprovalAssignmentActor")
  approvalAssignmentsReceived            PurchaseApprovalAssignment[]    @relation("ApprovalAssignmentTo")
  approvalDecisionsAssigned              PurchaseApprovalDecision[]      @relation("ApprovalAssignedApprover")
  approvalDecisionsMade                  PurchaseApprovalDecision[]      @relation("ApprovalDecidedBy")
  purchaseApprovalsConfirmed             PurchaseApprovalRequest[]       @relation("ApprovalConfirmedBy")
  purchaseApprovalsSubmitted             PurchaseApprovalRequest[]       @relation("ApprovalSubmittedBy")
  purchaseOrdersCreated                  PurchaseOrder[]                 @relation("PurchaseOrderBuyer")
  purchaseOrderApprovals                 PurchaseOrderApproval[]         @relation("POApprover")
  purchaseOrdersApproved                 PurchaseOrderApproval[]         @relation("POApprovedBy")
  quotes                                 Quote[]                         @relation("QuoteSubmitter")
  rfqs                                   RFQ[]                           @relation("RFQCreator")
  requestAttachments                     RequestAttachment[]             @relation("RequestAttachmentUploader")
  requirementApprovalAssignmentsMade     RequirementApprovalAssignment[] @relation("RequirementApprovalAssignmentActor")
  requirementApprovalAssignmentsReceived RequirementApprovalAssignment[] @relation("RequirementApprovalAssignmentTo")
  requirementApprovalDecisionsAssigned   RequirementApprovalDecision[]   @relation("RequirementApprovalAssignedApprover")
  requirementApprovalDecisionsMade       RequirementApprovalDecision[]   @relation("RequirementApprovalDecidedBy")
  requirementApprovalsApproved           RequirementApprovalRequest[]    @relation("RequirementApprovalApprovedBy")
  requirementApprovalsSubmitted          RequirementApprovalRequest[]    @relation("RequirementApprovalSubmittedBy")
  requirementDraftsConfirmed             RequirementDraft[]              @relation("RequirementDraftConfirmedBy")
  requirementDrafts                      RequirementDraft[]              @relation("RequirementDraftUser")
  savingsRecords                         SavingsRecord[]                 @relation("SavingsRecordBuyer")
  tenant                                 Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor                                 Vendor?                         @relation("VendorUsers", fields: [vendorId], references: [id], onDelete: Cascade)
  sentInvitations                        VendorInvitation[]              @relation("sentInvitations")
  vendorRatings                          VendorRating[]                  @relation("VendorRatingBuyer")
  vendorOnboardingApprovals              VendorOnboarding[]              @relation("VendorOnboardingReviewer")
  vendorOnboardingSubmissions            VendorOnboarding[]              @relation("VendorOnboardingSubmitter")
  vendorMatchings                         VendorMatching[]
  vendorAssignments                      VendorAssignment[]              @relation("VendorAssignments")
  vendorEvents                           VendorEvent[]                   @relation("VendorEventActor")
  vendorDocumentsUploaded                VendorDocument[]                @relation("VendorDocumentUploader")
  vendorDocumentsVerified                VendorDocument[]                @relation("VendorDocumentVerifier")
   vendorDuplicatesConfirmed              VendorDuplicate[]
   offerSubmissions                       CommercialOfferSubmission[] @relation("OfferSubmitter")
   offerEvents                            OfferEvent[]

   @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@index([vendorId])
  @@index([department])
}

model Category {
  id                       String                  @id @default(cuid())
  name                     String
  description              String?
  tenantId                 String
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  parentId                 String?
  parent                   Category?               @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children                 Category[]              @relation("CategoryHierarchy")
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests                 ProcurementRequest[]
  approvalRules            PurchaseApprovalRule[]
  requirementApprovalRules RequirementApprovalRule[]
  vendors                  Vendor[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([parentId])
}

model Vendor {
  id                       String                    @id @default(cuid())
  name                     String
  categoryId               String?
  contactPerson            String?
  email                    String?
  phone                    String?
  address                  String?
  city                     String?
  state                    String?
  country                  String?
  postalCode               String?
  products                 String?
  status                   VendorStatus              @default(PENDING_APPROVAL)
  approvedAt               DateTime?
  approvedBy               String?
  notes                    String?
  tenantId                 String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  businessHours            Json?
  gstin                    String?
  invitationToken          String?                   @unique
  invitedAt                DateTime?
  invitedById              String?
  isPublic                 Boolean                   @default(false)
  timeZone                 String?                   @default("Asia/Kolkata")
  verificationNotes        String?
  verificationStatus       VerificationStatus        @default(UNVERIFIED)
  verifiedAt               DateTime?
  verifiedBy               String?
  vendorType               VendorType?
  onboardingStatus         VendorOnboardingStatus    @default(INVITED)
  reportsAgainst           AbuseReport[]             @relation("ReportVendor")
  connections              Connection[]              @relation("Connections")
  blockedBy                ContactRestriction[]      @relation("RestrictionSellerVendor")
  deals                    Deal[]                    @relation("deals")
  dealRooms                DealRoom[]                @relation("dealRooms")
  invoices                 Invoice[]                 @relation("InvoiceVendor")
  interests                MarketplaceInterest[]
  messageAttachments       MessageAttachment[]       @relation("MessageAttachmentUploader")
  purchaseApprovalRequests PurchaseApprovalRequest[]
  purchaseOrders           PurchaseOrder[]           @relation("PurchaseOrderVendor")
  quotes                   Quote[]
  rfqs                     RFQVendor[]
  savingsRecords           SavingsRecord[]           @relation("savingsRecords")
  vendorUsers              User[]                    @relation("VendorUsers")
  category                 Category?                 @relation(fields: [categoryId], references: [id])
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  availability             VendorAvailability?       @relation("availability")
  invitations              VendorInvitation[]        @relation("vendorInvitations")
  performance              VendorPerformance?
  profile                  VendorProfile?
  ratings                  VendorRating[]
  workingHours             VendorWorkingHours[]
  capabilities             VendorCapability[]
  certifications           VendorCertification[]
  documents                VendorDocument[]
  onboarding               VendorOnboarding?
  matchings                VendorMatching[]
  assignments              VendorAssignment[]        @relation("VendorAssignments")
  commercialHistories       VendorCommercialHistory[]
  duplicateOf              VendorDuplicate[]         @relation("VendorDuplicatesPrimary")
  potentialDuplicateOf      VendorDuplicate[]        @relation("VendorDuplicatesSecondary")
   events                   VendorEvent[]
   commercialOffers         CommercialOffer[]         @relation("OfferVendor")

  @@index([tenantId])
  @@index([status])
  @@index([categoryId])
  @@index([invitationToken])
  @@index([isPublic])
}

/// A buyer-side restriction on a vendor. Enforced in `communication.service.ts`
/// on every seller-initiated path, so a restriction cannot be bypassed by
/// calling an endpoint the UI happens to hide.
model ContactRestriction {
  id        String              @id @default(cuid())
  tenantId  String
  /// The buyer who set it.
  buyerId   String
  vendorId  String
  /// The requirement it applies to, when scoped to one. Null = the whole buyer.
  requestId String?
  kind      RestrictionKind
  reason    String?
  /// Only meaningful for MUTE. A BLOCK never expires.
  expiresAt DateTime?
  createdAt DateTime            @default(now())
  buyer     User                @relation("RestrictionBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  request   ProcurementRequest? @relation("RestrictionRequester", fields: [requestId], references: [id], onDelete: Cascade)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor    Vendor              @relation("RestrictionSellerVendor", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([buyerId, vendorId, requestId, kind])
  @@index([tenantId])
  @@index([vendorId])
}

/// An abuse report filed by one party against a vendor.
model AbuseReport {
  id         String       @id @default(cuid())
  tenantId   String
  reporterId String
  vendorId   String
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  resolution String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  reporter   User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor     Vendor       @relation("ReportVendor", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([vendorId])
}

/// Per-user, per-event delivery preferences.
model NotificationPreference {
  id        String                @id @default(cuid())
  userId    String
  tenantId  String
  eventType String
  /// IMMEDIATE sends at once; DIGEST batches; OFF suppresses entirely.
  frequency NotificationFrequency @default(IMMEDIATE)
  updatedAt DateTime              @updatedAt
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User                  @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@index([tenantId])
}

/// The durable outbox. One row per intended email.
///
/// `dedupeKey` is the mechanism that prevents duplicate sends: a unique index
/// means a concurrent or repeated trigger loses the insert race instead of
/// mailing the user twice. `nextAttemptAt` supports retry of transient
/// failures; a row past `attempts` is marked PERMANENTLY_FAILED for an admin.
model EmailDelivery {
  id             String              @id @default(cuid())
  tenantId       String
  recipientId    String
  recipientEmail String
  eventType      String
  subject        String
  /// Rendered text body. Never contains confidential commercial terms: the
  /// builder is responsible for summary-only previews.
  bodyText       String
  bodyHtml       String?
  /// In-app route the email links to. Authentication is required on open.
  linkPath       String
  status         EmailDeliveryStatus @default(PENDING)
  /// Unique per logical notification. For a batched digest this is per user per
  /// window, so a burst of messages yields one email.
  dedupeKey      String              @unique
  attempts       Int                 @default(0)
  lastError      String?
  nextAttemptAt  DateTime            @default(now())
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  recipient      User                @relation("EmailDeliveryRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([recipientId])
  @@index([tenantId])
}

model VendorPerformance {
  id             String    @id @default(cuid())
  vendorId       String    @unique
  totalOrders    Int       @default(0)
  onTimeDelivery Float     @default(0)
  qualityRating  Float     @default(0)
  responsiveness Float     @default(0)
  lastOrderDate  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  vendor         Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model ProcurementRequest {
  id                          String                       @id @default(cuid())
  title                       String
  description                 String
  categoryId                  String?
  item                        String
  quantity                    Int
  unit                        String?
  location                    String
  requiredDate                DateTime
  specifications              String?
  estimatedBudget             Float?
  priority                    Int                          @default(1)
  status                      RequestStatus                @default(DRAFT)
  requesterId                 String
  assigneeId                  String?
  tenantId                    String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  /// Set when the requirement became visible in the open market.
  publishedAt                 DateTime?
  /// Sellers must submit by this time. Null means no deadline.
  quotationDeadline           DateTime?
  /// PRIVATE requirements are invite-only; OPEN_MARKET ones are discoverable.
  /// Defaults to PRIVATE so an existing requirement can never become public
  /// by omission - publishing is always a deliberate act.
  visibility                  RequestVisibility            @default(PRIVATE)
  costCenter                  String?
  /// Department and cost centre the purchase is charged to. Approval rules scope
  /// on these, so they are captured on the requirement rather than inferred from
  /// the requester at submission time.
  department                  String?
  approvals                   Approval[]
  connections                 Connection[]
  contactRestrictions         ContactRestriction[]         @relation("RestrictionRequester")
  deals                       Deal[]
  dealRooms                   DealRoom[]
  extractedReq                ExtractedRequirement?
  interests                   MarketplaceInterest[]
  assignee                    User?                        @relation("Assignee", fields: [assigneeId], references: [id])
  category                    Category?                    @relation(fields: [categoryId], references: [id])
  requester                   User                         @relation("Requester", fields: [requesterId], references: [id])
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseApprovalRequests    PurchaseApprovalRequest[]
  purchaseOrders              PurchaseOrder[]
  rfqs                        RFQ[]
  recommendation              Recommendation?
  attachments                 RequestAttachment[]
  requirementApprovalRequests RequirementApprovalRequest[]
  requirementDraft            RequirementDraft?            @relation("RequirementDraftRequest")
  savingsRecords              SavingsRecord[]              @relation("savingsRecords")
   vendorMatchings             VendorMatching[]
   vendorAssignments           VendorAssignment[]
   commercialOffers            CommercialOffer[]

   @@index([tenantId])
  @@index([status])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([visibility, status, tenantId])
}

/// A file attached to a requirement. Buyer-authored only; a seller's
/// equivalent lives on their quotation, so private buyer documents can never
/// be written by a seller.
model RequestAttachment {
  id           String             @id @default(cuid())
  requestId    String
  fileName     String
  mimeType     String
  size         Int
  content      Bytes
  uploadedById String
  tenantId     String
  createdAt    DateTime           @default(now())
  request      ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation("RequestAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([requestId])
  @@index([tenantId])
}

/// A seller's recorded interest in an open-market requirement.
///
/// This row is the record of a permitted buyer-seller interaction: a seller may
/// only be messaged once they have expressed interest, been invited, or hold an
/// accepted connection. It is created by the seller's own action, so it cannot
/// be forged on the buyer's behalf.
model MarketplaceInterest {
  id            String             @id @default(cuid())
  requestId     String
  vendorId      String
  submittedById String
  status        InterestStatus     @default(EXPRESSED)
  note          String?
  /// Set once the seller submits a quotation against this requirement.
  quoteId       String?            @unique
  tenantId      String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  quote         Quote?             @relation(fields: [quoteId], references: [id])
  request       ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  submittedBy   User               @relation("InterestSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor        Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([requestId, vendorId])
  @@index([tenantId])
  @@index([vendorId])
}

model ExtractedRequirement {
  id             String             @id @default(cuid())
  requestId      String             @unique
  category       String?
  item           String?
  quantity       Int?
  unit           String?
  location       String?
  requiredDate   DateTime?
  specifications String?
  budget         Float?
  missingFields  String[]
  confidence     Float              @default(0)
  rawResponse    Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  request        ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model RFQ {
  id                   String             @id @default(cuid())
  rfqNumber            String
  requestId            String
  title                String
  description          String
  quantity             Int
  specifications       String?
  deliveryLocation     String
  requiredDeliveryDate DateTime
  submissionDeadline   DateTime
  status               RFQStatus          @default(DRAFT)
  createdById          String
  tenantId             String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  quotes               Quote[]
  createdBy            User               @relation("RFQCreator", fields: [createdById], references: [id])
  request              ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendors              RFQVendor[]

  @@unique([rfqNumber, tenantId])
  @@index([tenantId])
  @@index([requestId])
  @@index([status])
}

model RFQVendor {
  id          String    @id @default(cuid())
  rfqId       String
  vendorId    String
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
  status      String    @default("INVITED")
  rfq         RFQ       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
}

model Quote {
  id                   String               @id @default(cuid())
  rfqId                String
  vendorId             String
  unitPrice            Float
  quantity             Int
  taxRate              Float                @default(0)
  taxAmount            Float                @default(0)
  freightAmount        Float                @default(0)
  installationAmount   Float                @default(0)
  warrantyMonths       Int?
