# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secrets (Must be at least 32 characters long in production)
JWT_SECRET=your-32-character-or-longer-jwt-secret-key-here
JWT_REFRESH_SECRET=your-32-character-or-longer-refresh-token-secret-here

# OpenAI Integration (Required for AI copilot, extraction, and recommendation features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# CORS & Application URLs
# For production, set to your Cloudflare Pages domain (e.g. https://navo.pages.dev)
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=100

# Email Delivery (log | smtp | http)
EMAIL_PROVIDER=log
EMAIL_FROM=NAVO <no-reply@navo.local>